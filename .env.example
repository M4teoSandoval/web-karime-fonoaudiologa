APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Zona horaria de la agenda (importante para el cálculo de disponibilidad).
APP_TIMEZONE=America/Bogota
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de datos
# Desarrollo local: sqlite (se crea database.sqlite automáticamente o usar migrations).
DB_CONNECTION=sqlite
# Producción (Railway PostgreSQL): usar DATABASE_URL o variables individuales.
# DB_CONNECTION=pgsql
# DATABASE_URL=postgresql://user:password@host:port/database
# DB_HOST=
# DB_PORT=5432
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Número de WhatsApp en formato internacional sin espacios ni signos.
# Debe coincidir entre el backend (WHATSAPP_NUMBER) y el frontend (VITE_WHATSAPP_NUMBER).
WHATSAPP_NUMBER=573150596654
VITE_WHATSAPP_NUMBER=573150596654

# Usuario administrador del panel. Se crea con `php artisan db:seed` o `php artisan db:seed --class=AdminUserSeeder`.
# No existe registro público de administradores. Estos valores deben establecerse para el entorno correspondiente.
ADMIN_NAME="Karime Sandoval"
ADMIN_EMAIL="karime@example.com"
ADMIN_PASSWORD="change-this-password"

# Zona horaria de la agenda (importante para el cálculo de disponibilidad).
APP_TIMEZONE=America/Bogota
